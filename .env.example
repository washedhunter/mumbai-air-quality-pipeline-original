# Copy to .env (never commit .env). Everything has a working default except the OpenAQ key.

# OpenAQ API key (free): https://explore.openaq.org/account
# Needed for the daily run (API) and station discovery. Historical days come from OpenAQ's public
# S3 archive, which needs no key. Without a key, use EXTRACT_SOURCE=sample to replay the committed sample.
OPENAQ_API_KEY=

# api | archive | auto (default: API for the last 6 days, archive for older days) | sample
# EXTRACT_SOURCE=auto
# ARCHIVE_MIN_AGE_DAYS=6

# Warehouse (published on localhost:5433 for Power BI)
# WAREHOUSE_PASSWORD=aq
# WAREHOUSE_PORT=5433

# How OpenAQ's "ppb" label on CPCB NO2/SO2/O3/CO is read: cpcb_native (default) or true_ppb
# PPB_LABEL_MEANS=cpcb_native

# Forecast / backtest
# FORECAST_HORIZON_DAYS=7
# FORECAST_MIN_DAYS_CITY=60
# FORECAST_MIN_DAYS_STATION=180
# BACKTEST_WEEKS=26
# BACKTEST_STATION_ORIGINS=6
# ALWAYS_FORECAST=false

# Airflow (local only)
# AIRFLOW_UID=50000
# AIRFLOW_JWT_SECRET=local-dev-jwt-secret-change-me
