{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "p3_line",
  "position": {
    "x": 16,
    "y": 204,
    "z": 8000,
    "height": 230,
    "width": 606,
    "tabOrder": 8000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "day"
                }
              },
              "queryRef": "dim_date.day",
              "nativeQueryRef": "day",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_station"
                    }
                  },
                  "Property": "zone"
                }
              },
              "queryRef": "dim_station.zone",
              "nativeQueryRef": "zone"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Avg Concentration"
                }
              },
              "queryRef": "_Measures.Avg Concentration",
              "nativeQueryRef": "Avg Concentration"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Daily concentration by zone'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12.0D"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}